# ==============================================================================
# KRISHI Platform Environment Configuration Template
# Copy this file to .env and fill in the values according to SETUP.md
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=*
LOG_LEVEL=info

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/krishi_db?schema=public

# Cache & Queues (Redis)
REDIS_URL=redis://localhost:6379

# Authentication & JWT
# NOTE: Rotate JWT secrets in production using: openssl rand -hex 32
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# SMS OTP Provider ("msg91" | "twilio")
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloud Object Storage (S3 / Cloudflare R2)
S3_BUCKET_NAME=krishi-assets
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_CDN_URL=

# Maps & Navigation (Google Maps)
GOOGLE_MAPS_SERVER_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Push Notifications (Expo)
EXPO_ACCESS_TOKEN=

# Mandi Commodity Prices (data.gov.in Agmarknet)
DATA_GOV_API_KEY=

# Monitoring & Error Reporting (Sentry)
SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=

# AI Creative Studio Provider ("openai" | "gemini")
AI_PROVIDER=gemini
AI_API_KEY=
