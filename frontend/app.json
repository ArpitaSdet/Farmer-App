{
  "expo": {
    "name": "Kisan Kendra - Farmer App",
    "slug": "kisan-kendra",
    "version": "1.0.7",
    "orientation": "portrait",
    "primaryColor": "#1B5E20",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#1B5E20"
      },
      "package": "com.kisankendra.farmerapp",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "versionCode": 7
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kisan Kendra uses your location to deliver orders and machines to your farm and to show delivery tracking.",
          "locationAlwaysAndWhenInUsePermission": "Kisan Kendra shares your location during active deliveries so farmers can track their order.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-build-properties",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B5E20"
    },
    "extra": {
      "apiUrl": "https://farmer-app-klid.onrender.com"
    }
  }
}